{
  "name": "memory-atlas",
  "version": "1.0.0",
  "description": "Memory Atlas - 电影感暗色极光风格的纪念相册",
  "main": "api/src/index.ts",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "tsx api/src/index.ts",
    "server:watch": "nodemon --watch api/src --ext ts --exec \"tsx api/src/index.ts\"",
    "dev:all": "concurrently -n FE,BE -c cyan,magenta \"npm run dev\" \"npm run server\"",
    "check": "tsc --noEmit"
  },
  "keywords": ["photo-album", "memory", "react", "express", "sqlite"],
  "author": "Memory Atlas",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "framer-motion": "^11.18.2",
    "leaflet": "1.9",
    "lucide-react": "^1.17.0",
    "multer": "^1.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.30.4",
    "uuid": "^9.0.1",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/leaflet": "^1.9.21",
    "@types/multer": "^1.4.13",
    "@types/react": "^18.3.30",
    "@types/react-dom": "^18.3.7",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
